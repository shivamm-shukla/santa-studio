# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real API keys.

# Free LLM tiers. The default "router" provider tries each of these in turn,
# skipping any that is out of quota for the day, so more keys means fewer
# stalled runs. One is enough to get started; all four are free and none
# needs a card.
GEMINI_API_KEY=      # aistudio.google.com
GROQ_API_KEY=        # console.groq.com
CEREBRAS_API_KEY=    # cloud.cerebras.ai
OPENROUTER_API_KEY=  # openrouter.ai/keys

# Caches LLM responses so re-running a crashed pipeline costs nothing. Off by
# default: a review gate's "regenerate" sends the same prompt, and a cache
# would return the same answer. Useful while developing.
SANTA_STUDIO_LLM_CACHE=

# Where projects, the asset cache and credentials are stored. Defaults to the
# platform convention (~/.local/share/santa-studio on Linux).
SANTA_STUDIO_HOME=

# Paid, higher quality - only used if ACTIVE_PROVIDERS["llm"] is set to "claude"
ANTHROPIC_API_KEY=

PEXELS_API_KEY=
PIXABAY_API_KEY=

# Generated stills, used only where all three stock libraries came back empty.
# Without any of these the free keyless service (Pollinations) is used, which
# caps at 1024x576 and ignores which model you ask it for.
#
# Cloudflare Workers AI is the quality upgrade and takes the lead as soon as
# both of these are set: a free signup, no card, 10,000 neurons/day, running
# FLUX.1-schnell (Apache-2.0, so commercially safe). Account ID is on the
# Workers & Pages page; the token comes from My Profile -> API Tokens using
# the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Gemini image generation is NOT on the free tier - a key without billing is
# refused with `limit: 0`, not with a spent allowance. Leave this off until
# billing is enabled on the Google Cloud project.
GEMINI_IMAGE_ENABLED=

# Scores each generated still against the shot's subject with a vision model,
# so a good photograph of the wrong thing loses to a worse one of the right
# thing. Free on the Gemini tier and on by default whenever GEMINI_API_KEY is
# set; "false" switches it off.
VISUAL_RELEVANCE_CHECK=

# From @BotFather, and the chat id you want approvals/notifications sent to
# (only needed to run bot_main.py instead of main.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# "autonomous" (default) or "checkpoints"
REVIEW_MODE=autonomous

# Required by the "xtts" voice provider (the default), which clones your
# voice from an uploaded sample. XTTS-v2 is licensed under the Coqui Public
# Model License, which forbids commercial use - read https://coqui.ai/cpml
# and set this to 1 to record your agreement. Leave it unset and switch
# ACTIVE_PROVIDERS["voice"] to "gtts" if you'd rather not agree.
COQUI_TOS_AGREED=1

# ---- Publishing to YouTube -------------------------------------------------
# The account itself is connected once, interactively:
#     python studio.py youtube connect
# which stores a token under config/credentials/ and turns publishing on.
# Nothing below is needed just to render videos.

# The OAuth 2.0 Client ID (Desktop app) downloaded from the Google Cloud
# Console, with the YouTube Data API v3 enabled on the project.
YOUTUBE_CREDENTIALS_FILE=client_secret.json

# Where the stored token lives. Leave unset to keep it in the studio's own
# credentials directory, which `export` excludes and `clean` never touches.
YOUTUBE_TOKEN_FILE=

# Unset means "publish if an account is connected". Set to "none" to keep
# runs ending at the finished file even with an account connected, or to a
# provider name to force it.
PUBLISH_TARGET=

# Which Whisper model transcribes narration for caption timing.
# tiny | base | small | medium | large - bigger is more accurate and slower,
# and the model downloads once on first use.
WHISPER_MODEL=medium

# Which voice narrates. Unset picks the best installed cloning provider, and
# falls back to gTTS when none is installed. "xtts" clones well but its
# weights forbid commercial use, so it is never chosen automatically.
# chatterbox | xtts | gtts
VOICE_PROVIDER=

# How the cloned voice reads. Unset uses settings tuned for narration, which
# is what you want almost always; these are here for when a particular
# reference sample needs coaxing.
#
# VOICE_CFG_WEIGHT is the one worth reaching for first. It decides how hard
# the delivery is pinned to the reference clip's cadence. The library ships
# 0.5, which on a paragraph of narration reads as though every sentence were
# being spoken under duress; the studio uses 0.3, which lets the pace follow
# the sentence. Lower it further for a reference speaker who talks fast.
#
# VOICE_EXAGGERATION is how much emphasis is added: 0.4 is a narrator, 0.7 is
# an actor, and above that it starts editorialising sentences that did not
# ask for it.
VOICE_CFG_WEIGHT=
VOICE_EXAGGERATION=
VOICE_TEMPERATURE=
VOICE_REPETITION_PENALTY=

# Playback speed of the finished narration, 1.0 being however fast the
# reference sample reads. The pitch is preserved, so 1.1 is the same voice
# speaking a little faster rather than a chipmunk. Clamped to 0.7-1.5.
VOICE_PACE=

# The look the editor cuts to when a run has no reference channel to learn one
# from: documentary | fast_explainer | calm_narrative, or the name of a profile
# already learned from a reference. A run with a reference overrides this.
STYLE_PROFILE=documentary
