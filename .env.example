# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real API keys.

# Free LLM tiers. The default "router" provider tries each of these in turn,
# skipping any that is out of quota for the day, so more keys means fewer
# stalled runs. One is enough to get started; all four are free and none
# needs a card.
GEMINI_API_KEY=      # aistudio.google.com
GROQ_API_KEY=        # console.groq.com
CEREBRAS_API_KEY=    # cloud.cerebras.ai
OPENROUTER_API_KEY=  # openrouter.ai/keys

# Caches LLM responses so re-running a crashed pipeline costs nothing. Off by
# default: a review gate's "regenerate" sends the same prompt, and a cache
# would return the same answer. Useful while developing.
SANTA_STUDIO_LLM_CACHE=

# Where projects, the asset cache and credentials are stored. Defaults to the
# platform convention (~/.local/share/santa-studio on Linux).
SANTA_STUDIO_HOME=

# Paid, higher quality - only used if ACTIVE_PROVIDERS["llm"] is set to "claude"
ANTHROPIC_API_KEY=

PEXELS_API_KEY=
PIXABAY_API_KEY=

# From @BotFather, and the chat id you want approvals/notifications sent to
# (only needed to run bot_main.py instead of main.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# "autonomous" (default) or "checkpoints"
REVIEW_MODE=autonomous

# Required by the "xtts" voice provider (the default), which clones your
# voice from an uploaded sample. XTTS-v2 is licensed under the Coqui Public
# Model License, which forbids commercial use - read https://coqui.ai/cpml
# and set this to 1 to record your agreement. Leave it unset and switch
# ACTIVE_PROVIDERS["voice"] to "gtts" if you'd rather not agree.
COQUI_TOS_AGREED=1
