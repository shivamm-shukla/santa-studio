.env
venv/
__pycache__/
*.pyc
# Everything a run produces - state, downloaded stock footage,
# generated audio, rendered video - is regenerable output, not source.
runs/**
!runs/.gitkeep
*TEMP_MPY_*.mp4
.pytest_cache/

# Scratch renders and probe images from development. Anything worth keeping
# belongs in docs/ and gets referenced from a document.
samples/*
!samples/.gitkeep

# Film footage. Frame sequences are enormous and every one of them is
# reproducible from the recorders in room/ - see reel/README if you need them
# back.
build/

# Finished films. Large, and rebuildable from reel/ - see reel/README.md.
*.mp4
!samples/*.mp4

# Footage the film's laptop screen plays. Reproducible with reel/film_frames.py
# and the landing recorder; 118MB has no business in a clone.
room/public/reel/landing/
room/public/reel/film/

# A commercial grant is personal - it is signed for one holder and belongs
# to them, not to a checkout of the project.
licence.json
